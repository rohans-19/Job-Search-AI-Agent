# ===========================================================================
# Job Search AI Agent — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your actual API keys.
# The .env file is already listed in .gitignore so secrets stay off GitHub.
#
# HOW IT WORKS
# ------------
# config.py loads this file automatically at import time using python-dotenv.
# Every module that needs credentials imports from config.py — no keys are
# ever hardcoded in source files.
#
# ---------------------------------------------------------------------------
# Adzuna Jobs API  (free tier — https://developer.adzuna.com/)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ---------------------------------------------------------------------------
# Jooble Jobs API  (request free key — https://jooble.org/api/about)
# ---------------------------------------------------------------------------
JOOBLE_API_KEY=your_jooble_api_key_here

# ---------------------------------------------------------------------------
# Number of results to request from each live API connector (default: 15)
# ---------------------------------------------------------------------------
JOB_FETCH_COUNT=15
